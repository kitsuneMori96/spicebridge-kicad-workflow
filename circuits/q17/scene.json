          "gap": 29,
          "items": [
            {"text": "正峰是瓶颈", "at": 1.6, "accent": true},
            {"text": "截止侧先碰墙", "at": 1.8},
            {"text": "50 mV 正峰 {{wave.pk_pos:+.2f}} V", "at": 2.1},
            {"text": "扫描正峰 {{walls.pos:+.2f}} V", "at": 2.35},
            {"text": "负峰可达 -{{walls.neg_abs:.2f}} V", "at": 2.6},
            {"text": "教材 {{textbook.neg:+.1f}} V 偏保守", "at": 2.85}
