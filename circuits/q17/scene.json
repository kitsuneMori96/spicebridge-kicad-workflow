          "size": 13,
          "row_height": 44,
          "header_height": 32,
          "columns": [
            {"label": "口径", "width": 1.5},
            {"label": "正峰", "width": 1.05, "align": "end"},
            {"label": "负峰", "width": 1.05, "align": "end"},
            {"label": "U_{o}", "width": 1.15, "align": "end"}
          ],
          "rows": [
            {"cells": ["教材估算", "+{{textbook.pos:.2f}} V", "-{{textbook.neg_abs:.2f}} V",
                       "{{textbook.rms:.2f}} Vrms"], "at": 0.3},
            {"cells": ["50 mV 波形", "{{wave.pk_pos:+.2f}} V", "-{{wave.pk_neg_abs:.2f}} V",
                       "{{wave.u_o_rms:.2f}} Vrms"], "at": 0.8},
