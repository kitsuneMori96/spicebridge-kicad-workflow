          "gap": 28,
          "lines": [
            {"text": "U_{o} = min(正峰, |负峰|) / √2", "at": 2.9},
            {"text": "≈ {{answer.rms_lo:.2f}}–{{answer.rms_hi:.2f}} Vrms ≈ [[2 V]]", "at": 3.3}
          ]
        }
      ]
